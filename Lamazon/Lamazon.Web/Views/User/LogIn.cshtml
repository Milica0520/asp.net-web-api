@model Lamazon.Services.ViewModels.User.LogInUserViewModel

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-5">
            <div class="card">

                <div class="card-header">
                    <h2>Login</h2>
                </div>
               
                <div class="card-body">

                    @using (Html.BeginForm("LogIn", "User", FormMethod.Post))
                    {
                       
                        <div class="form-group">
                            <label asp-for="Email" class="control-label"></label>
                            <input asp-for="Email" class="form-control" />
                            <span asp-validation-for="Email" class="text-danger"></span>
                        </div>

                        <label asp-for="Password" class="me-2">Password</label>
                        <div class="form-group d-flex align-items-center position-relative">

                            @Html.PasswordFor(model => model.Password, new { @class = "form-control", placeholder = "Enter your password", id = "Password" })
                            <button type="button" class="btn btn-outline-secondary" id="togglePassword">
                                <i class="fa fa-eye"></i>
                            </button>
                            <span asp-validation-for="Password" class="text-danger"></span>
                        </div>
                     
                        <div class="form-group">
                            <a asp-controller="Home" asp-action="Index" class="btn btn-secondary">Cancel</a>
                            <button type="submit" class="btn btn-primary">Login</button>
                        </div>
                    }
                  
                </div>

            </div>
        </div>
    </div>
</div>
<script>
    const togglePassword = document.getElementById('togglePassword');
    const passwordField = document.getElementById('Password');

    togglePassword.addEventListener('click', function () {
        const type = passwordField.getAttribute('type') === 'password' ? 'text' : 'password';
        passwordField.setAttribute('type', type);
        this.innerHTML = type === 'password' ? '<i class="fa fa-eye"></i>' : '<i class="fa fa-eye-slash"></i>';
    });
</script>
<style>
    .form-control {
        padding-right: 40px;
    }

    .eye-toggle {
        background: none;
        border: none;
        top: 50%;
        right: 10px;
        transform: translateY(-50%);
        cursor: pointer;
        color: #6c757d;
    }

        .eye-toggle:hover,
        .eye-toggle:focus {
            background: none;
            border: none;
            outline: none;
            color: #6c757d;
        }

        .eye-toggle i {
            font-size: 18px;
        }
</style>