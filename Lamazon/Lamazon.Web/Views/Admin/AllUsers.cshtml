@using Lamazon.Services.ViewModels.Admin
@model List<AdminUserVM>


<h1>All users:</h1>


<table class="table">
    <thead>
        <tr>
            <th scope="col">Id</th>
            <th scope="col">User name</th>
            <th scope="col">UserRole</th>
            <th scope="col">Email</th>

        </tr>
    </thead>
    <tbody>
        @foreach (AdminUserVM item in Model)
        {
            <tr>
                <td>@item.Id</td>
                <td>@item.UserName</td>
                <td>@item.RoleId</td>
                <td>@item.Email</td>
                <td>
                    @Html.ActionLink("Edit", "Edit", "User", new { id = item.Id })
                    @Html.ActionLink("Delete", "Delete", "User", new { id = item.Id })
                   
                </td>
            </tr>
        }
    </tbody>
</table>
